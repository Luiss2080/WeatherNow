# Copia este archivo a `.env` y rellena los valores.
# Obtén una API key gratis en https://openweathermap.org/api
#
# NOTA: estas variables se incluyen en el bundle del cliente. La protección real
# de la clave se hará con el proxy de la spec 002.

VITE_API_URL_BASE=https://api.openweathermap.org/data/2.5
VITE_API_KEY=tu_api_key_aqui
VITE_IDIOMA=es
VITE_UNIDADES=metric
