# Copia este archivo a `.env` y rellena los valores.
# Obtén una API key gratis en https://openweathermap.org/api
#
# Estas variables las usa el PROXY (servidor). Al no llevar el prefijo VITE_, NO
# se incluyen en el bundle del navegador (spec 002, RF-14).

OPENWEATHER_API_KEY=tu_api_key_aqui
OPENWEATHER_URL_BASE=https://api.openweathermap.org/data/2.5
OPENWEATHER_IDIOMA=es
OPENWEATHER_UNIDADES=metric

# Límites del proxy (opcionales)
API_MAX_PETICIONES=60
API_VENTANA_MS=600000
