{
  "name": "weathernow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "api": "node --env-file-if-exists=.env api/servidor.js",
    "typecheck": "tsc --noEmit",
